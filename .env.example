# Copy to .env and fill in. Never commit .env.

# Optional. Without it the AI tutor falls back to built-in offline answers.
# Get a key at https://console.anthropic.com
CLAUDE_API_KEY=

# MongoDB (used by docker-compose)
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change_me

# Mongo Express admin UI login
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=change_me

# Required. Generate one with: openssl rand -hex 32
JWT_SECRET=change_me
JWT_EXPIRE=7d

# App
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
